{#
 # Paramètres > Profil > Objectifs hebdomadaires, dans le formulaire ProfileType (même bouton Enregistrer) :
 #  - tous sports confondus : AthleteProfile.weeklyDistanceGoalKm / weeklySessionsGoal ;
 #  - par sport : CollectionType "weeklyGoals" (table weeklyGoal), lignes ajoutées / retirées par
 #    weekly_goals_controller.js à partir du gabarit <template>.
 # Variables : form (ProfileType), sports (liste ordonnée des sports).
 #}
{% set _usedSportIds = [] %}
{% for goal in form.weeklyGoals %}
    {% if goal.vars.data and goal.vars.data.sport %}
        {% set _usedSportIds = _usedSportIds|merge([goal.vars.data.sport.id]) %}
    {% endif %}
{% endfor %}

<section class="sp-goals" id="weekly-goals" aria-labelledby="weekly-goals-title">
    <h2 class="sp-settings-section-title sp-goals-title" id="weekly-goals-title">{{ 'settings.goals.section_title'|trans }}</h2>

    <h3 class="sp-goals-subtitle">{{ 'settings.goals.all_sports'|trans }}</h3>
    <div class="sp-settings-form-grid">
        <div class="sp-settings-field">
            {{ form_label(form.weeklyDistanceGoalKm, 'settings.goals.weekly_distance'|trans) }}
            {{ form_widget(form.weeklyDistanceGoalKm, {attr: {class: 'sp-settings-input'}}) }}
            {{ form_errors(form.weeklyDistanceGoalKm) }}
        </div>
        <div class="sp-settings-field">
            {{ form_label(form.weeklySessionsGoal, 'settings.goals.weekly_sessions'|trans) }}
            {{ form_widget(form.weeklySessionsGoal, {attr: {class: 'sp-settings-input'}}) }}
            {{ form_errors(form.weeklySessionsGoal) }}
        </div>
    </div>

    <div class="sp-goals-sport" data-controller="weekly-goals"
         data-weekly-goals-remove-label-value="{{ 'settings.goals.remove'|trans }}"
         data-weekly-goals-added-value="{{ 'settings.goals.added'|trans }}"
         data-weekly-goals-removed-value="{{ 'settings.goals.removed'|trans }}">
        <h3 class="sp-goals-subtitle">{{ 'settings.goals.by_sport'|trans }}</h3>
        <p class="sp-goals-help">{{ 'settings.goals.by_sport_help'|trans }}</p>

        {% for error in form.weeklyGoals.vars.errors %}
            <p class="sp-goal-error">{{ error.message }}</p>
        {% endfor %}

        <p class="sp-goals-empty" data-weekly-goals-target="empty"{{ form.weeklyGoals|length > 0 ? ' hidden' }}>
            {{ 'settings.goals.empty'|trans }}
        </p>
        <ul class="sp-goal-list" data-weekly-goals-target="list">
            {% for goal in form.weeklyGoals %}
                {{ include('settings/_weekly_goal_row.html.twig', {goal: goal}) }}
            {% endfor %}
        </ul>
        {% do form.weeklyGoals.setRendered() %}

        <template data-weekly-goals-target="template">
            {{- include('settings/_weekly_goal_row.html.twig', {goal: form.weeklyGoals.vars.prototype}) -}}
        </template>

        {% set _available = sports|filter(s => s.id not in _usedSportIds)|length %}
        <div class="sp-goal-add">
            <div class="dropdown">
                <button type="button" class="sp-btn sp-btn-outline dropdown-toggle sp-goal-add-btn" id="weekly-goal-add"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        data-weekly-goals-target="addButton"{{ _available == 0 ? ' disabled' }}>
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'settings.goals.add'|trans }}
                </button>
                <ul class="dropdown-menu sp-goal-add-menu" aria-labelledby="weekly-goal-add">
                    {% for sport in sports %}
                        {% set _name = ('sport.' ~ sport.slug)|trans %}
                        <li data-weekly-goals-target="option" data-sport-id="{{ sport.id }}"{{ sport.id in _usedSportIds ? ' hidden' }}>
                            <button type="button" class="dropdown-item sp-goal-add-item"
                                    data-action="weekly-goals#add"
                                    data-weekly-goals-sport-param="{{ sport.id }}"
                                    data-weekly-goals-name-param="{{ _name }}"
                                    data-weekly-goals-icon-param="{{ sport.icon }}"
                                    data-weekly-goals-color-param="{{ sport.color }}">
                                <span class="sp-goal-sport-icon" style="--goal-sport-color: {{ sport.color }}">
                                    <i class="bi {{ sport.icon }}" aria-hidden="true"></i>
                                </span>
                                {{ _name }}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <p class="sp-goals-all-used" data-weekly-goals-target="allUsed"{{ _available > 0 ? ' hidden' }}>
                {{ 'settings.goals.all_used'|trans }}
            </p>
        </div>
        <p class="visually-hidden" role="status" data-weekly-goals-target="status"></p>
    </div>
</section>

<style>
    .sp-goals-title { margin-top: 24px; }
    .sp-goals-subtitle {
        font-size: 13px; font-weight: 700; color: var(--sp-text);
        margin: 0 0 12px; letter-spacing: .01em;
    }
    .sp-goals-sport { margin-bottom: 28px; }
    .sp-goals-help, .sp-goals-empty, .sp-goals-all-used { font-size: 13px; color: var(--sp-muted); margin: -4px 0 12px; }
    .sp-goals-all-used { margin: 0; }

    .sp-goal-list { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 12px; }
    .sp-goal-row {
        position: relative; background: #F9F9F9; border: 1.5px solid transparent;
        border-radius: 12px; padding: 14px 16px 16px;
    }
    .sp-goal-row.has-error { border-color: rgba(239, 68, 68, .45); }
    .sp-goal-fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
    .sp-goal-legend {
        float: none; width: auto; display: flex; align-items: center; gap: 10px;
        font-size: 14px; font-weight: 700; color: var(--sp-text); line-height: 1.3;
        margin: 0 44px 12px 0; padding: 0;
    }
    .sp-goal-sport-icon {
        width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--goal-sport-color, #9CA3AF); color: #fff; font-size: 14px;
    }
    .sp-goal-remove {
        position: absolute; top: 10px; right: 10px; width: 34px; height: 34px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 0; border-radius: 9px; background: transparent; color: var(--sp-muted); font-size: 15px;
        transition: background .15s, color .15s;
    }
    .sp-goal-remove:hover { background: rgba(239, 68, 68, .1); color: var(--sp-red); }
    .sp-goal-remove:focus-visible, .sp-goal-add-item:focus-visible { outline: 2px solid var(--sp-orange); outline-offset: 2px; }

    .sp-goal-fields { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .sp-goal-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .sp-goal-field label {
        font-size: 11px; font-weight: 600; color: var(--sp-muted);
        text-transform: uppercase; letter-spacing: .5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sp-goal-input { padding: 8px 10px; background: #fff; min-width: 0; }
    .sp-goal-input.is-invalid { border-color: var(--sp-red); }
    .sp-goal-error { font-size: 12px; color: var(--sp-red); margin: 2px 0 0; }
    .sp-goal-row-errors { margin: -4px 0 10px; }

    .sp-goal-add { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; }
    .sp-goal-add-btn { display: inline-flex; align-items: center; gap: 6px; }
    .sp-goal-add-btn:disabled { opacity: .5; cursor: not-allowed; }
    .sp-goal-add-menu { min-width: 220px; padding: 6px; border-radius: 12px; border-color: var(--sp-border); box-shadow: 0 8px 24px rgba(0, 0, 0, .12); }
    .sp-goal-add-item { display: flex; align-items: center; gap: 10px; border-radius: 8px; padding: 7px 10px; font-size: 14px; }
    .sp-goal-add-item:active { background: rgba(232, 64, 12, .1); color: var(--sp-text); }

    @media (max-width: 576px) {
        .sp-goal-row { padding: 12px 12px 14px; }
        .sp-goal-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    }
</style>
