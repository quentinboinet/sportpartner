{#
    Écart d'un total de la vue d'ensemble avec la période précédente (ComparisonPresenter::overview) :
    pourcentage (ou écart absolu si la période précédente vaut 0), flèche, et valeur précédente.
#}
{% set _icons = {up: 'bi-arrow-up-right', down: 'bi-arrow-down-right', flat: 'bi-arrow-right'} %}
<div class="sp-stats-total-delta sp-cmp-tone--{{ m.tone }}" data-metric="{{ m.key }}" data-tone="{{ m.tone }}">
    <span class="visually-hidden">{{ 'stats.compare.overview_sr'|trans }}</span>
    {% if m.direction == 'none' %}
        <span aria-hidden="true">-</span><span class="visually-hidden">{{ 'stats.compare.sr.none'|trans }}</span>
    {% else %}
        <i class="bi {{ _icons[m.direction] }}" aria-hidden="true"></i>
        <span class="sp-stats-total-delta-val">{{ m.percent ?? m.delta }}</span>
        <span class="visually-hidden">{{ ('stats.compare.sr.' ~ m.direction)|trans }}</span>
    {% endif %}
    <span class="sp-stats-total-delta-ref">{{ 'stats.compare.vs'|trans }} {{ m.b }}</span>
</div>
