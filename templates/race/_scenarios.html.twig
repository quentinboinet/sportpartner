{#
 # Plan de course, phase 2 : scénarios (objectifs de temps) et temps de passage.
 # Inclus par race/plan.html.twig sous le tableau des repères. Styles : assets/styles/race_plan.css.
 # Variables attendues : race, scenarioView (ScenarioViewBuilder::buildWith(), voir son docblock).
 #
 # Calcul en direct pendant la saisie : Stimulus "race-splits" (assets/controllers/race_splits_controller.js),
 # miroir de SplitCalculator::fillAuto() + compute(). Le rendu serveur ci-dessous est la référence (sans JS).
 #
 # Temps fixés / auto : un repère dont le temps est enregistré est "fixé" (input avec name="splits[id]",
 # data-sc-state="pinned", bouton de désépinglage visible) ; les autres sont "auto" : l'input affiche le temps
 # calculé (s.autos) mais n'a PAS de name, il n'est donc jamais posté. Le JS bascule l'état pendant la saisie.
 #
 # Stratégie d'allure (macro strategy_fields, dans chaque formulaire de scénario et dans les deux formulaires de
 # création) : select name="strategy" + intensité en radios name="strategy_intensity" (masquée pour « Régulier » mais
 # toujours postée) + phrase d'explication. Formules : App\Entity\PacingStrategy. Création : stratégie proposée
 # selon le type de course (_sv.suggestedStrategy). Colonne des allures : écart avec l'allure moyenne en mouvement
 # (row.paceDeviationPct, macro dev).
 #
 # Bande des tronçons (macro strip, data-sc-strip) : version ENREGISTRÉE du scénario au rendu, mise à jour en direct par
 # race-splits (renderStrip, niveaux de teinte = stripLevels() du contrôleur, même formule que la macro).
 #}
{% set _fr  = app.request.locale == 'fr' %}
{% set _dec = _fr ? ',' : '.' %}
{% set _th  = _fr ? ' ' : ',' %}
{% set _sv = scenarioView %}
{% set _scenarios = _sv.scenarios %}
{% set _first = _scenarios|first %}
{% set _durationPattern = '\\s*\\d{1,3}\\s*(:\\s*[0-5]\\d(\\s*:\\s*[0-5]\\d)?|[hH](\\s*[0-5]\\d)?)\\s*' %}
{% set _lastStart = _scenarios is not empty ? (_scenarios|last).startTime : null %}

{# Données statiques des repères pour le calcul en direct (D+ issus du calcul serveur) #}
{% set _cpData = [] %}
{% set _cpNames = {} %}
{% for cp in _sv.checkpoints %}
    {% set _r = _first ? _first.calc.rows[loop.index0] : null %}
    {% set _cpData = _cpData|merge([{
        id: cp.id, name: cp.name, type: cp.type.value, distanceM: cp.distanceM,
        stopSeconds: cp.stopSeconds, cutoffSeconds: cp.cutoffSeconds,
        segmentGainM: _r ? _r.segmentGainM : 0, cumulativeGainM: _r ? _r.cumulativeGainM : 0,
    }]) %}
    {% set _cpNames = _cpNames|merge({('c' ~ cp.id): cp.name}) %}
{% endfor %}

{# Phrases d'explication des stratégies d'allure, pour le changement en direct #}
{% set _strategyDesc = {} %}
{% for st in _sv.strategies %}
    {% set _strategyDesc = _strategyDesc|merge({(st.value): st.descriptionKey|trans}) %}
{% endfor %}

{% set _labels = {
    start: 'race_plan.start'|trans,
    day: 'race_plan.sc_day'|trans,
    dayTitle: 'race_plan.sc_day_title'|trans,
    departure: 'race_plan.sc_departure'|trans,
    speed: 'race_plan.sc_speed'|trans,
    perKm: 'race_plan.sc_per_km'|trans,
    paceTitle: 'race_plan.sc_pace_title'|trans,
    marginOk: 'race_plan.sc_margin_ok'|trans,
    marginTight: 'race_plan.sc_margin_tight_text'|trans,
    marginMissed: 'race_plan.sc_margin_missed'|trans,
    statusOk: 'race_plan.sc_status_ok'|trans,
    statusTight: 'race_plan.sc_status_tight'|trans,
    statusMissed: 'race_plan.sc_status_missed'|trans,
    minutes: 'race_plan.minutes_short'|trans,
    cutoffsNone: 'race_plan.sc_cutoffs_none'|trans,
    cutoffOk: 'race_plan.sc_cutoff_ok_n'|trans,
    cutoffTight: 'race_plan.sc_cutoff_tight_n'|trans,
    cutoffMissed: 'race_plan.sc_cutoff_missed_n'|trans,
    errNotIncreasing: 'race_plan.sc_err_not_increasing'|trans,
    errAfterFinish: 'race_plan.sc_err_after_finish'|trans,
    errInvalid: 'race_plan.sc_err_invalid'|trans,
    errZero: 'race_plan.sc_err_zero'|trans,
    errNameBlank: 'race_plan.sc_err_name_blank'|trans,
    errorsOne: 'race_plan.sc_errors_one'|trans,
    errorsMany: 'race_plan.sc_errors_many'|trans,
    confirmDirty: 'race_plan.sc_confirm_dirty'|trans,
    confirmDistribute: 'race_plan.sc_confirm_distribute'|trans,
    confirmDistributeDirty: 'race_plan.sc_confirm_distribute_dirty'|trans,
    confirmPrintDirty: 'race_plan.sc_confirm_print_dirty'|trans,
    autoTitle: 'race_plan.sc_auto_title'|trans,
    pinnedTitle: 'race_plan.sc_pinned_title'|trans,
    stateAuto: 'race_plan.sc_state_auto'|trans,
    statePinned: 'race_plan.sc_state_pinned'|trans,
    devValue: 'race_plan.sc_dev'|trans,
    devTitle: 'race_plan.sc_dev_title'|trans,
    strategyDesc: _strategyDesc,
} %}

{# ── Champs communs : nom, heure de départ, temps visé ── #}
{% macro scenario_fields(prefix, name, startTime, target, pattern, required) %}
    <div class="rp-sc-fields">
        <div class="rp-sc-field rp-sc-field--name">
            <label class="sp-form-label" for="{{ prefix }}-name">{{ 'race_plan.sc_field_name'|trans }}{% if required %} <span class="rp-required">*</span>{% endif %}</label>
            <input type="text" id="{{ prefix }}-name" name="name" class="sp-form-input" maxlength="60" autocomplete="off"
                   value="{{ name }}" {{ required ? 'required' : '' }}
                   {% if required %}aria-describedby="{{ prefix }}-name-err"{% endif %}
                   placeholder="{{ 'race_plan.sc_field_name_placeholder'|trans }}" data-sc-name>
            {% if required %}
                <div class="rp-sc-err" id="{{ prefix }}-name-err" data-sc-field-error></div>
            {% else %}
                <div class="sp-form-help">{{ 'race_plan.sc_field_name_help'|trans }}</div>
            {% endif %}
        </div>
        <div class="rp-sc-field">
            <label class="sp-form-label" for="{{ prefix }}-start">{{ 'race_plan.sc_field_start'|trans }}</label>
            <input type="time" id="{{ prefix }}-start" name="start_time" class="sp-form-input rp-sc-start"
                   value="{{ startTime }}" data-sc-start>
        </div>
        <div class="rp-sc-field">
            <label class="sp-form-label" for="{{ prefix }}-target">{{ 'race_plan.sc_field_target'|trans }}</label>
            <input type="text" id="{{ prefix }}-target" name="target" class="sp-form-input rp-sc-duration"
                   value="{{ target }}" inputmode="text" autocomplete="off" pattern="{{ pattern }}"
                   placeholder="{{ 'race_plan.sc_field_target_placeholder'|trans }}"
                   title="{{ 'race_plan.sc_field_duration_help'|trans }}"
                   aria-describedby="{{ prefix }}-target-help {{ prefix }}-target-err"
                   data-sc-duration data-sc-target>
            <div class="sp-form-help" id="{{ prefix }}-target-help">{{ 'race_plan.sc_field_duration_help'|trans }}</div>
            <div class="rp-sc-err" id="{{ prefix }}-target-err" data-sc-field-error></div>
        </div>
    </div>
{% endmacro %}

{# ── Stratégie d'allure : choix, intensité (masquée pour « Régulier », toujours postée), explication ── #}
{% macro strategy_fields(prefix, sv, strategy, intensity) %}
    <div class="rp-sc-strategy" data-sc-strategy-block>
        <div class="rp-sc-field rp-sc-field--strategy">
            <label class="sp-form-label" for="{{ prefix }}-strategy">{{ 'race_plan.sc_field_strategy'|trans }}</label>
            <select id="{{ prefix }}-strategy" name="strategy" class="sp-form-input rp-sc-strategy-select"
                    aria-describedby="{{ prefix }}-strategy-desc" data-sc-strategy>
                {% for st in sv.strategies %}
                    <option value="{{ st.value }}" {{ st.value == strategy.value ? 'selected' : '' }}>
                        {{- st.labelKey|trans -}}
                        {%- if st.value == sv.suggestedStrategy.value and st.usesIntensity %} {{ 'race_plan.sc_strategy_suggested'|trans }}{% endif -%}
                    </option>
                {% endfor %}
            </select>
        </div>
        <fieldset class="rp-sc-field rp-sc-intensity" data-sc-intensity-group {{ strategy.usesIntensity ? '' : 'hidden' }}>
            <legend class="sp-form-label">{{ 'race_plan.sc_field_intensity'|trans }}</legend>
            <div class="rp-sc-seg">
                {% for it in sv.intensities %}
                    <input type="radio" class="rp-sc-seg-input" id="{{ prefix }}-intensity-{{ it.value }}" name="strategy_intensity"
                           value="{{ it.value }}" {{ it.value == intensity.value ? 'checked' : '' }} data-sc-intensity>
                    <label class="rp-sc-seg-label" for="{{ prefix }}-intensity-{{ it.value }}">{{ it.labelKey|trans }}</label>
                {% endfor %}
            </div>
        </fieldset>
        <p class="rp-sc-strategy-desc" id="{{ prefix }}-strategy-desc" aria-live="polite" data-sc-strategy-desc>{{ strategy.descriptionKey|trans }}</p>
    </div>
{% endmacro %}

{# ── Écart d'allure d'un tronçon avec l'allure moyenne en mouvement (même rendu que deviationBadge() en JS) ── #}
{% macro dev(pct, avgPace) -%}
    <span class="rp-sc-dev rp-sc-dev--{{ pct > 0 ? 'slow' : (pct < 0 ? 'fast' : 'even') }}"
          title="{{ 'race_plan.sc_dev_title'|trans({'%pace%': avgPace is not null ? avgPace|race_pace : ''}) }}">
        {{- 'race_plan.sc_dev'|trans({'%v%': (pct > 0 ? '+' : '') ~ pct}) -}}
    </span>
{%- endmacro %}

{# ── Heure d'horloge + badge J+n ── #}
{% macro clock(clock) %}
    {% if clock %}
        <span class="rp-sc-clock">{{ clock.time }}</span>
        {%- if clock.dayOffset > 0 %} <span class="rp-sc-day" title="{{ 'race_plan.sc_day_title'|trans({'%n%': clock.dayOffset}) }}">{{ 'race_plan.sc_day'|trans({'%n%': clock.dayOffset}) }}</span>{% endif %}
    {% else %}
        <span class="rp-empty">-</span>
    {% endif %}
{% endmacro %}

{# ── Heure d'un repère sur la bande des tronçons (même texte que stripClock() en JS) : heure (+ J+n), sinon temps
   écoulé sans heure de départ, sinon "-" ── #}
{% macro strip_clock(row) -%}
    {%- if row.clock -%}
        {{- row.clock.time -}}{%- if row.clock.dayOffset > 0 %} {{ 'race_plan.sc_day'|trans({'%n%': row.clock.dayOffset}) }}{% endif -%}
    {%- elseif row.arrivalSeconds is not null -%}
        {{- row.arrivalSeconds|race_duration -}}
    {%- else -%}-{%- endif -%}
{%- endmacro %}

{# ── Bande des tronçons : largeur = distance du tronçon, teinte = allure (niveaux 1 à 5, plus foncé = plus rapide ;
   0 = sans allure), heure et nom au-dessus de chaque repère. Purement visuelle (aria-hidden) : le tableau ci-dessous
   donne les mêmes heures et allures. Niveau = 1 + floor(t * 4 + 0.5), t = (max - allure) / (max - min), 0,5 si toutes
   les allures sont égales : même formule que stripLevels() de race_splits_controller.js ── #}
{% macro strip(s, sv, dec, th) %}
    {% set calc = s.calc %}
    {% set _finishM = calc.totals.distanceM %}
    {% if _finishM > 0 %}
        {% set _rows = calc.rows|merge([calc.finish]) %}
        {% set _paces = _rows|filter(r => r.segmentPaceSecPerKm is not null)|map(r => r.segmentPaceSecPerKm) %}
        {% set _pmin = _paces is empty ? 0 : min(_paces) %}
        {% set _pmax = _paces is empty ? 0 : max(_paces) %}
        <div class="rp-strip" data-sc-strip aria-hidden="true">
            <div class="rp-strip-labels">
                <span class="rp-strip-lab rp-strip-lab--first" data-strip-label="start">
                    <span class="rp-strip-clock" data-strip-clock>{{ s.startTime ?? '0:00' }}</span>
                    <span class="rp-strip-name">{{ 'race_plan.start'|trans }}</span>
                </span>
                {% for row in _rows %}
                    <span class="rp-strip-lab{{ loop.last ? ' rp-strip-lab--last' }}" style="left:{{ (row.distanceM * 100 / _finishM)|number_format(3, '.', '') }}%"
                          data-strip-label="{{ row.checkpointId ?? 'finish' }}">
                        <span class="rp-strip-clock" data-strip-clock>{{ _self.strip_clock(row) }}</span>
                        <span class="rp-strip-name">{{ loop.last ? 'race_plan.finish'|trans : sv.checkpoints[loop.index0].name }}</span>
                    </span>
                {% endfor %}
            </div>
            <div class="rp-strip-bar">
                {% set _prev = 0 %}
                {% for row in _rows %}
                    {% set _len = row.distanceM - _prev %}
                    {% set _pace = row.segmentPaceSecPerKm %}
                    {% set _lvl = 0 %}
                    {% if _pace is not null %}
                        {% set _t = _pmax == _pmin ? 0.5 : (_pmax - _pace) / (_pmax - _pmin) %}
                        {% set _lvl = 1 + (_t * 4 + 0.5)|round(0, 'floor') %}
                    {% endif %}
                    <span class="rp-strip-seg rp-strip-seg--{{ _lvl }}"
                          style="left:{{ (_prev * 100 / _finishM)|number_format(3, '.', '') }}%;width:{{ (_len * 100 / _finishM)|number_format(3, '.', '') }}%"
                          data-strip-seg="{{ row.checkpointId ?? 'finish' }}" data-distance="{{ _len }}" {{ _len > 0 ? '' : 'hidden' }}>
                        <span class="rp-strip-fill"><b data-strip-pace>{{ _pace is not null ? _pace|race_pace : '-' }}</b><small>{{ 'race_plan.sc_per_km'|trans }}</small></span>
                    </span>
                    {% set _prev = row.distanceM %}
                {% endfor %}
            </div>
            <div class="rp-strip-foot">
                <span>{{ 'race_plan.strip_legend'|trans }}</span>
                <span class="rp-strip-km">0 → {{ (_finishM / 1000)|number_format(1, dec, th) }} km</span>
            </div>
        </div>
    {% endif %}
{% endmacro %}

{# Conteneur du contrôleur : englobe la section ET la modale d'ajout #}
<div class="rp-sc-root"
     data-controller="race-splits"
     data-race-splits-checkpoints-value="{{ _cpData|json_encode }}"
     data-race-splits-route-distance-value="{{ _sv.routeDistanceM }}"
     data-race-splits-efforts-value="{{ _sv.efforts|json_encode }}"
     data-race-splits-locale-value="{{ app.request.locale }}"
     data-race-splits-labels-value="{{ _labels|json_encode }}">

<section class="sp-card rp-sc-card" id="scenarios" data-rp-section aria-labelledby="scenarios-title">

    <div class="rp-sec-head rp-sc-head">
        <div class="rp-sec-ico" aria-hidden="true"><i class="bi bi-stopwatch"></i></div>
        <div class="rp-sec-titles">
            <h2 class="rp-sec-title" id="scenarios-title">{{ 'race_plan.sc_title'|trans }}</h2>
            <p class="rp-sec-sub">{{ 'race_plan.sc_sub'|trans }}</p>
        </div>
        {% if _scenarios is not empty %}
            {# ── Onglets : un par scénario + ajout ── #}
            <div class="rp-sec-right rp-sc-tabbar">
                <div class="rp-sc-tabs" role="tablist" aria-label="{{ 'race_plan.sc_tablist_label'|trans }}">
                    {% for s in _scenarios %}
                        <button type="button" role="tab" class="rp-sc-tab"
                                id="scenario-tab-{{ s.id }}" aria-controls="scenario-{{ s.id }}"
                                aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}"
                                data-race-splits-target="tab" data-scenario-id="{{ s.id }}"
                                data-action="click->race-splits#selectTab keydown->race-splits#tabKeydown">
                            <span class="rp-sc-tab-name" data-sc-tab-name>{{ s.name }}</span>
                            <span class="rp-sc-tab-target" data-sc-tab-target {{ s.target ? '' : 'hidden' }}>{{ s.target }}</span>
                            <span class="rp-sc-tab-dot" data-sc-tab-dirty title="{{ 'race_plan.sc_unsaved'|trans }}" hidden></span>
                        </button>
                    {% endfor %}
                </div>
                <div class="rp-sc-tabbar-add">
                    <button type="button" class="rp-sc-add" id="scenario-add-btn"
                            data-bs-toggle="modal" data-bs-target="#scenarioAddModal"
                            title="{{ _sv.canAddScenario ? 'race_plan.sc_btn_add_title'|trans : 'race_plan.sc_limit'|trans({'%max%': _sv.maxScenarios}) }}"
                            {{ _sv.canAddScenario ? '' : 'disabled aria-describedby=scenario-limit-hint' }}>
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'race_plan.sc_btn_add'|trans }}
                    </button>
                    {% if not _sv.canAddScenario %}
                        <span class="rp-sc-limit" id="scenario-limit-hint">{{ 'race_plan.sc_limit'|trans({'%max%': _sv.maxScenarios}) }}</span>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

    {# Messages flash des actions sur les scénarios : la redirection ancre la page ici (#scenario-{id}), loin du haut
       de page où base.html.twig les affiche ; le contrôleur les déplace dans ce conteneur #}
    <div class="rp-sc-flash" data-sc-flash></div>

    {% if _scenarios is empty %}

        {# ── Aucun scénario : explication + création du premier ── #}
        <div class="rp-sc-empty" data-sc-empty>
            <div class="rp-sc-empty-intro">
                <p class="rp-sc-empty-text">{{ 'race_plan.sc_empty_text'|trans }}</p>
                <ul class="rp-features">
                    <li><i class="bi bi-flag" aria-hidden="true"></i> {{ 'race_plan.sc_feature_target'|trans }}</li>
                    <li><i class="bi bi-clock" aria-hidden="true"></i> {{ 'race_plan.sc_feature_splits'|trans }}</li>
                    <li><i class="bi bi-hourglass-split" aria-hidden="true"></i> {{ 'race_plan.sc_feature_cutoffs'|trans }}</li>
                    <li><i class="bi bi-magic" aria-hidden="true"></i> {{ 'race_plan.sc_feature_distribute'|trans }}</li>
                    <li><i class="bi bi-speedometer2" aria-hidden="true"></i> {{ 'race_plan.sc_feature_strategy'|trans }}</li>
                </ul>
            </div>
            <form method="post" action="{{ path('app_race_scenario_add', {id: race.id}) }}" id="scenario-create-form"
                  class="rp-sc-create" data-action="input->race-splits#validate change->race-splits#validate invalid->race-splits#reveal:capture submit->race-splits#submitted">
                <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">
                {{ _self.scenario_fields('sc-new', '', null, '', _durationPattern, false) }}
                {{ _self.strategy_fields('sc-new', _sv, _sv.suggestedStrategy, _sv.suggestedIntensity) }}
                <div class="rp-sc-create-actions">
                    <button type="submit" class="sp-btn sp-btn-primary" data-sc-btn="create">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'race_plan.sc_create_first'|trans }}
                    </button>
                </div>
            </form>
        </div>

    {% else %}

        {# ── Un panneau par scénario ── #}
        {% for s in _scenarios %}
            {% set calc = s.calc %}
            {% set _sid = s.id %}
            {% set _p = 'sc-' ~ _sid %}
            {% set _counts = {ok: 0, tight: 0, missed: 0} %}
            {% for row in calc.rows %}
                {% if row.cutoffStatus != 'none' %}
                    {% set _counts = _counts|merge({(row.cutoffStatus): _counts[row.cutoffStatus] + 1}) %}
                {% endif %}
            {% endfor %}
            {% set _rowErrors = calc.errors|filter(e => e.checkpointId is not null or e.code != 'stops_exceed_target')|length %}
            {% set _stopsExceed = calc.errors|filter(e => e.code == 'stops_exceed_target')|length > 0 %}

            {# Pas de tabindex : le panneau commence par un champ focusable (motif APG), et l'ancre #scenario-{id}
               des redirections ne doit pas donner le focus (ni son contour) à tout le panneau #}
            <div class="rp-sc-panel" role="tabpanel" id="scenario-{{ _sid }}" aria-labelledby="scenario-tab-{{ _sid }}"
                 data-race-splits-target="panel" data-scenario-id="{{ _sid }}"
                 data-has-pins="{{ s.pinnedCount > 0 ? '1' : '0' }}" {{ loop.first ? '' : 'hidden' }}>

                <form method="post" action="{{ path('app_race_scenario_save', {id: race.id, sid: _sid}) }}"
                      id="scenario-form-{{ _sid }}" class="rp-sc-form" data-sc-form
                      data-action="input->race-splits#update change->race-splits#update focusin->race-splits#selectAuto invalid->race-splits#reveal:capture submit->race-splits#submitted">
                    <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">

                    <div class="rp-sc-formgrid">
                        {{ _self.scenario_fields(_p, s.name, s.startTime, s.target, _durationPattern, true) }}
                        {{ _self.strategy_fields(_p, _sv, s.strategy, s.intensity) }}
                    </div>

                    {# Résumé #}
                    <dl class="rp-sc-summary">
                        <div>
                            <dt>{{ 'race_plan.sc_sum_target'|trans }}</dt>
                            <dd data-sc-sum="target">{{ s.targetSeconds is not null ? s.targetSeconds|race_duration_input : '-' }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'race_plan.sc_sum_arrival'|trans }}</dt>
                            <dd data-sc-sum="arrival">{{ _self.clock(calc.finish.clock) }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'race_plan.sc_sum_pace'|trans }}</dt>
                            <dd data-sc-sum="pace">{% if calc.totals.avgPaceSecPerKm is not null %}{{ calc.totals.avgPaceSecPerKm|race_pace }}<small> {{ 'race_plan.sc_per_km'|trans }}</small>{% else %}-{% endif %}</dd>
                        </div>
                        <div>
                            <dt>{{ 'race_plan.sc_sum_stops'|trans }}</dt>
                            <dd data-sc-sum="stops">{{ calc.totals.stopSeconds < 3600 ? 'race_plan.minutes_short'|trans({'%n%': (calc.totals.stopSeconds / 60)|round(0, 'floor')}) : calc.totals.stopSeconds|race_duration }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'race_plan.sc_sum_cutoffs'|trans }}</dt>
                            <dd data-sc-sum="cutoffs">
                                {% if _counts.ok + _counts.tight + _counts.missed == 0 %}
                                    <span class="rp-empty">{{ 'race_plan.sc_cutoffs_none'|trans }}</span>
                                {% else %}
                                    {% for status in ['ok', 'tight', 'missed'] %}
                                        {% if _counts[status] > 0 %}<span class="rp-sc-pill rp-sc-pill--{{ status }}">{{ ('race_plan.sc_cutoff_' ~ status ~ '_n')|trans({'%n%': _counts[status]}) }}</span>{% endif %}
                                    {% endfor %}
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'race_plan.sc_sum_pinned'|trans }}</dt>
                            <dd data-sc-sum="pinned">{{ s.pinnedCount }}/{{ calc.rows|length }}</dd>
                        </div>
                    </dl>

                    {# Bande des tronçons (allure de chaque tronçon, heure de passage à chaque repère) #}
                    {{ _self.strip(s, _sv, _dec, _th) }}

                    {# Alertes globales #}
                    <div class="rp-sc-alert rp-sc-alert--error" data-sc-alert="stops" role="alert" {{ _stopsExceed ? '' : 'hidden' }}>
                        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> {{ 'race_plan.sc_err_stops_exceed'|trans }}
                    </div>
                    <div class="rp-sc-alert rp-sc-alert--warn" data-sc-alert="errors" {{ _rowErrors > 0 ? '' : 'hidden' }}>
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        <span data-sc-alert-text>{{ (_rowErrors == 1 ? 'race_plan.sc_errors_one' : 'race_plan.sc_errors_many')|trans({'%count%': _rowErrors}) }}</span>
                    </div>
                    {% if _sv.routeDistanceM == 0 %}
                        <div class="rp-sc-alert rp-sc-alert--info"><i class="bi bi-info-circle" aria-hidden="true"></i> {{ 'race_plan.sc_no_distance'|trans }}</div>
                    {% endif %}

                    {# Tableau des temps de passage #}
                    <div class="rp-table-wrap">
                        <table class="rp-table rp-sc-table">
                            <thead>
                                <tr>
                                    <th class="rp-col-num">#</th>
                                    <th class="rp-sc-sticky">{{ 'race_plan.sc_col_cp'|trans }}</th>
                                    <th class="rp-num-cell">{{ 'race_plan.col_km'|trans }}</th>
                                    <th class="rp-num-cell">{{ 'race_plan.sc_col_gain'|trans }}</th>
                                    <th>{{ 'race_plan.sc_col_time'|trans }}</th>
                                    <th>{{ 'race_plan.sc_col_clock'|trans }}</th>
                                    <th>{{ 'race_plan.sc_col_stop'|trans }}</th>
                                    <th class="rp-num-cell">{{ 'race_plan.sc_col_pace'|trans }}</th>
                                    <th class="rp-num-cell">{{ 'race_plan.sc_col_avg'|trans }}</th>
                                    <th>{{ 'race_plan.sc_col_cutoff'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {# Départ #}
                                <tr class="rp-row-edge" data-sc-row="start">
                                    <td class="rp-col-num"><span class="rp-edge-dot rp-edge-dot--start"></span></td>
                                    <td class="rp-name-cell rp-sc-sticky"><span class="rp-name">{{ 'race_plan.start'|trans }}</span></td>
                                    <td class="rp-num-cell rp-strong">{{ 0|number_format(1, _dec, _th) }}</td>
                                    <td class="rp-num-cell"><span class="rp-empty">-</span></td>
                                    <td class="rp-sc-time-cell"><span class="rp-sc-zero">0:00</span></td>
                                    <td class="rp-nowrap" data-sc="clock">
                                        {% if s.startTime %}<span class="rp-sc-clock">{{ s.startTime }}</span>{% else %}<span class="rp-empty">-</span>{% endif %}
                                    </td>
                                    <td></td><td></td><td></td><td></td>
                                </tr>

                                {% for row in calc.rows|merge([calc.finish]) %}
                                    {% set _isFinish = loop.last %}
                                    {% set _cpId = row.checkpointId %}
                                    {% set _rp = _isFinish ? _p ~ '-finish' : _p ~ '-' ~ _cpId %}
                                    {% set _pinned = not _isFinish and (s.pinned[_cpId] ?? false) %}
                                    <tr class="{{ _isFinish ? 'rp-row-edge' : '' }} {{ row.errors is not empty ? 'rp-sc-row--error' : '' }} {{ _pinned ? 'rp-sc-row--pinned' : '' }}"
                                        data-sc-row="{{ _isFinish ? 'finish' : 'checkpoint' }}" {% if not _isFinish %}data-cp-id="{{ _cpId }}"{% endif %}>
                                        <td class="rp-col-num">
                                            {% if _isFinish %}
                                                <span class="rp-edge-dot rp-edge-dot--finish"></span>
                                            {% else %}
                                                <span class="rp-cp-pin rp-cp-pin--{{ row.type }}">{{ loop.index }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="rp-name-cell rp-sc-sticky">
                                            {% if _isFinish %}
                                                <span class="rp-name">{{ 'race_plan.finish'|trans }}</span>
                                            {% else %}
                                                {% set _cp = _sv.checkpoints[loop.index0] %}
                                                <span class="rp-name">
                                                    <i class="bi {{ _cp.type.icon }}" style="color:{{ _cp.type.color }}" title="{{ _cp.type.labelKey|trans }}"></i>
                                                    {{ row.name }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="rp-num-cell rp-strong">{{ (row.distanceM / 1000)|number_format(1, _dec, _th) }}</td>
                                        <td class="rp-num-cell">
                                            {% if _sv.route %}
                                                <span class="rp-up" title="{{ 'race_plan.sc_gain_title'|trans({'%gain%': row.segmentGainM|number_format(0, _dec, _th)}) }}">+{{ row.cumulativeGainM|number_format(0, _dec, _th) }} m</span>
                                            {% else %}<span class="rp-empty">-</span>{% endif %}
                                        </td>
                                        <td class="rp-sc-time-cell">
                                            {% if _isFinish %}
                                                {# Temps visé : jamais modifié par le calcul (cadenas) #}
                                                <div class="rp-sc-time-wrap rp-sc-time-wrap--finish">
                                                    <input type="text" class="sp-form-input rp-sc-time rp-sc-duration" value="{{ s.target }}"
                                                           inputmode="text" autocomplete="off" pattern="{{ _durationPattern }}"
                                                           placeholder="{{ 'race_plan.sc_time_placeholder'|trans }}"
                                                           aria-label="{{ 'race_plan.sc_finish_time_label'|trans }}"
                                                           aria-describedby="{{ _rp }}-err"
                                                           data-sc-duration data-sc-finish-target>
                                                    <i class="bi bi-lock-fill rp-sc-lock" aria-hidden="true"></i>
                                                </div>
                                            {% else %}
                                                {% set _state = _pinned ? 'pinned' : 'auto' %}
                                                <div class="rp-sc-time-wrap">
                                                    <input type="text" {% if _pinned %}name="splits[{{ _cpId }}]"{% endif %}
                                                           class="sp-form-input rp-sc-time rp-sc-duration {{ _pinned ? '' : 'rp-sc-time--auto' }}"
                                                           value="{{ _pinned ? s.inputs[_cpId] : (s.autos[_cpId] ?? '') }}"
                                                           inputmode="text" autocomplete="off" pattern="{{ _durationPattern }}"
                                                           placeholder="{{ 'race_plan.sc_time_placeholder'|trans }}"
                                                           title="{{ (_pinned ? 'race_plan.sc_pinned_title' : 'race_plan.sc_auto_title')|trans }}"
                                                           aria-label="{{ 'race_plan.sc_time_label'|trans({'%name%': row.name}) }}"
                                                           aria-describedby="{{ _rp }}-state {{ _rp }}-err"
                                                           data-sc-duration data-sc-split="{{ _cpId }}"
                                                           data-sc-state="{{ _state }}" data-sc-initial="{{ _state }}">
                                                    <button type="button" class="rp-sc-unpin" data-sc-unpin="{{ _cpId }}"
                                                            data-action="race-splits#unpin"
                                                            title="{{ 'race_plan.sc_unpin'|trans }}" aria-label="{{ 'race_plan.sc_unpin'|trans }}"
                                                            {{ _pinned ? '' : 'hidden' }}>
                                                        <i class="bi bi-pin-angle-fill" aria-hidden="true"></i>
                                                    </button>
                                                    <span class="rp-sc-auto" data-sc-auto-badge title="{{ 'race_plan.sc_auto_title'|trans }}"
                                                          aria-hidden="true" {{ _pinned ? 'hidden' : '' }}>{{ 'race_plan.sc_auto'|trans }}</span>
                                                    <span class="visually-hidden" id="{{ _rp }}-state" data-sc-state-text>{{ (_pinned ? 'race_plan.sc_state_pinned' : 'race_plan.sc_state_auto')|trans }}</span>
                                                </div>
                                            {% endif %}
                                            <div class="rp-sc-err" id="{{ _rp }}-err" data-sc="error">
                                                {%- for code in row.errors -%}
                                                    <span>{{ ('race_plan.sc_err_' ~ code)|trans }}</span>
                                                {%- endfor -%}
                                            </div>
                                        </td>
                                        <td class="rp-nowrap" data-sc="clock">{{ _self.clock(row.clock) }}</td>
                                        <td class="rp-nowrap">
                                            {% if row.stopSeconds > 0 %}
                                                <span class="rp-sc-stop"><i class="bi bi-pause-circle" aria-hidden="true"></i> {{ 'race_plan.sc_stop'|trans({'%n%': (row.stopSeconds / 60)|round}) }}</span>
                                                <span class="rp-sc-sub" data-sc="dep">{% if row.departureClock %}{{ 'race_plan.sc_departure'|trans({'%time%': row.departureClock.time}) }}{% endif %}</span>
                                            {% endif %}
                                        </td>
                                        <td class="rp-num-cell" data-sc="pace">
                                            {% if row.segmentPaceSecPerKm is not null %}
                                                {% set _from = row.paceFromCheckpointId is null ? 'race_plan.start'|trans : (_cpNames['c' ~ row.paceFromCheckpointId] ?? '') %}
                                                <span class="rp-sc-pace" title="{{ 'race_plan.sc_pace_title'|trans({'%time%': row.segmentMovingSeconds|race_duration, '%km%': (row.paceSpanDistanceM / 1000)|number_format(1, _dec, _th), '%from%': _from}) }}">{{ row.segmentPaceSecPerKm|race_pace }}<small> {{ 'race_plan.sc_per_km'|trans }}</small></span>
                                                <span class="rp-sc-sub">{{ 'race_plan.sc_speed'|trans({'%v%': row.segmentSpeedKmh|number_format(1, _dec, _th)}) }}
                                                    {%- if row.paceDeviationPct is not null %} {{ _self.dev(row.paceDeviationPct, calc.totals.avgPaceSecPerKm) }}{% endif -%}
                                                </span>
                                            {% else %}<span class="rp-empty">-</span>{% endif %}
                                        </td>
                                        <td class="rp-num-cell" data-sc="avg">
                                            {% if row.avgPaceSecPerKm is not null %}{{ row.avgPaceSecPerKm|race_pace }}<small> {{ 'race_plan.sc_per_km'|trans }}</small>{% else %}<span class="rp-empty">-</span>{% endif %}
                                        </td>
                                        <td class="rp-nowrap">
                                            {% if row.cutoffSeconds is not null %}
                                                <span class="rp-cutoff"><i class="bi bi-hourglass-split" aria-hidden="true"></i> {{ row.cutoffSeconds|race_duration }}</span>
                                                <span class="rp-sc-margin rp-sc-margin--{{ row.cutoffStatus }}" data-sc="margin"
                                                      {% if row.cutoffStatus != 'none' %}title="{{ ('race_plan.sc_status_' ~ row.cutoffStatus)|trans }}"{% endif %}>
                                                    {%- if row.cutoffStatus != 'none' -%}
                                                        {# "serrée" écrit en toutes lettres : pas seulement la couleur (WCAG 1.4.1) #}
                                                        {{ {ok: 'race_plan.sc_margin_ok', tight: 'race_plan.sc_margin_tight_text', missed: 'race_plan.sc_margin_missed'}[row.cutoffStatus]|trans({'%m%': row.cutoffMarginSeconds|abs|race_duration}) }}
                                                    {%- endif -%}
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Actions : enregistrer (+ modifications non enregistrées), répartir, dupliquer, imprimer, supprimer #}
                    <div class="rp-sc-footer">
                        <div class="rp-sc-footer-main">
                            <button type="submit" class="sp-btn sp-btn-primary rp-btn-sm" data-sc-btn="save">
                                <i class="bi bi-check-lg" aria-hidden="true"></i> {{ 'race_plan.sc_save'|trans }}
                            </button>
                            <span class="rp-sc-dirty" data-sc-dirty role="status" hidden>
                                <i class="bi bi-circle-fill" aria-hidden="true"></i> {{ 'race_plan.sc_unsaved'|trans }}
                            </span>
                        </div>
                        <div class="rp-sc-actions">
                            <button type="submit" form="scenario-distribute-{{ _sid }}" class="rp-btn-quiet rp-btn-sm" data-sc-btn="distribute"
                                    title="{{ 'race_plan.sc_distribute_help'|trans }}"
                                    aria-describedby="{{ _p }}-distribute-what"
                                    {{ s.targetSeconds is null ? 'disabled' : '' }}>
                                <i class="bi bi-magic" aria-hidden="true"></i> {{ 'race_plan.sc_distribute'|trans }}
                            </button>
                            <button type="submit" form="scenario-duplicate-{{ _sid }}" class="rp-btn-quiet rp-btn-sm" data-sc-btn="duplicate"
                                    {{ _sv.canAddScenario ? '' : 'disabled' }}
                                    title="{{ _sv.canAddScenario ? 'race_plan.sc_duplicate_title'|trans : 'race_plan.sc_limit'|trans({'%max%': _sv.maxScenarios}) }}">
                                <i class="bi bi-copy" aria-hidden="true"></i> {{ 'race_plan.sc_duplicate'|trans }}
                            </button>
                            {# Fiche construite depuis la base : confirmation si le scénario a des modifications non enregistrées #}
                            <a href="{{ path('app_race_plan_print', {id: race.id, scenario: _sid}) }}" target="_blank" rel="noopener"
                               class="rp-btn-quiet rp-btn-sm" data-sc-btn="print" title="{{ 'race_plan.sc_print_title'|trans }}"
                               data-action="race-splits#printGuard">
                                <i class="bi bi-printer" aria-hidden="true"></i> {{ 'race_plan.sc_print'|trans }}
                            </a>
                            <button type="submit" form="scenario-delete-{{ _sid }}" class="rp-btn-quiet rp-btn-sm rp-btn-danger" data-sc-btn="delete">
                                <i class="bi bi-trash3" aria-hidden="true"></i> {{ 'race_plan.sc_delete'|trans }}
                            </button>
                        </div>
                    </div>
                    {# Ce que fait « Répartir », visible (le title ne l'est ni au toucher ni pour les lecteurs d'écran) et
                       description du bouton (aria-describedby) ; sans temps visé, pourquoi il est indisponible #}
                    <p class="rp-sc-distribute-what" id="{{ _p }}-distribute-what">{{ 'race_plan.sc_distribute_help_inline'|trans }}{% if s.targetSeconds is null %} {{ 'race_plan.sc_distribute_need_target'|trans }}{% endif %}</p>

                    {# Calcul des temps auto (repliable) #}
                    <details class="rp-sc-how">
                        <summary><i class="bi bi-info-circle" aria-hidden="true"></i> {{ 'race_plan.sc_how_title'|trans }}</summary>
                        <p class="rp-sc-distribute-help" id="{{ _p }}-distribute-help" data-sc-help>{{ 'race_plan.sc_pins_help'|trans }}</p>
                    </details>
                </form>

                {# Formulaires des actions (hors du formulaire principal, déclenchés par les boutons form="…") #}
                <form method="post" action="{{ path('app_race_scenario_distribute', {id: race.id, sid: _sid}) }}"
                      id="scenario-distribute-{{ _sid }}" data-sc-action="distribute"
                      data-action="submit->race-splits#confirmAction">
                    <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">
                </form>
                <form method="post" action="{{ path('app_race_scenario_duplicate', {id: race.id, sid: _sid}) }}"
                      id="scenario-duplicate-{{ _sid }}" data-sc-action="duplicate"
                      data-action="submit->race-splits#confirmAction">
                    <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">
                </form>
                <form method="post" action="{{ path('app_race_scenario_delete', {id: race.id, sid: _sid}) }}"
                      id="scenario-delete-{{ _sid }}" data-sc-action="delete"
                      data-confirm="{{ 'race_plan.sc_confirm_delete'|trans({'%name%': s.name}) }}"
                      data-action="submit->race-splits#confirmAction">
                    <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">
                </form>
            </div>
        {% endfor %}

    {% endif %}
</section>

{# ── Modale : nouveau scénario ── #}
{% if _scenarios is not empty and _sv.canAddScenario %}
<div class="modal fade" id="scenarioAddModal" tabindex="-1" aria-hidden="true" aria-labelledby="scenarioAddModalTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content sp-modal">
            <div class="modal-header sp-modal-header">
                <h5 class="modal-title" id="scenarioAddModalTitle">{{ 'race_plan.sc_modal_title'|trans }}</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'race_plan.cancel'|trans }}"></button>
            </div>
            <form method="post" action="{{ path('app_race_scenario_add', {id: race.id}) }}" id="scenario-add-form"
                  data-action="input->race-splits#validate change->race-splits#validate invalid->race-splits#reveal:capture submit->race-splits#submitted">
                <input type="hidden" name="_token" value="{{ csrf_token('race_plan') }}">
                <div class="modal-body sp-modal-body">
                    <p class="rp-sc-modal-help">{{ 'race_plan.sc_modal_help'|trans }}</p>
                    {{ _self.scenario_fields('sc-add', '', _lastStart, '', _durationPattern, false) }}
                    {{ _self.strategy_fields('sc-add', _sv, _sv.suggestedStrategy, _sv.suggestedIntensity) }}
                </div>
                <div class="modal-footer sp-modal-footer">
                    <button type="button" class="sp-btn rp-btn-cancel" data-bs-dismiss="modal">{{ 'race_plan.cancel'|trans }}</button>
                    <button type="submit" class="sp-btn sp-btn-primary" data-sc-btn="add">{{ 'race_plan.sc_modal_submit'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

</div>
